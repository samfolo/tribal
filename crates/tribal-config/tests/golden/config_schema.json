{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
      "AgentsConfig": {
        "additionalProperties": false,
        "description": "The `[agents]` section: per-stage executor selection and budgets.",
        "properties": {
          "extraction": {
            "allOf": [
              {
                "$ref": "#/definitions/StageAgentConfig"
              }
            ],
            "description": "The extraction stage's agentic configuration."
          },
          "relation": {
            "allOf": [
              {
                "$ref": "#/definitions/StageAgentConfig"
              }
            ],
            "description": "The relation stage's agentic configuration."
          },
          "triage": {
            "allOf": [
              {
                "$ref": "#/definitions/StageAgentConfig"
              }
            ],
            "description": "The triage stage's agentic configuration."
          }
        },
        "type": "object"
      },
      "ApiKey": {
        "format": "password",
        "type": "string",
        "writeOnly": true
      },
      "AuthConfig": {
        "additionalProperties": false,
        "description": "Authentication settings.\n\nControls token lifetime defaults.",
        "properties": {
          "token_ttl_hours": {
            "description": "Default token lifetime in hours.\n\nDefaults to 8760 (~1 year).",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "CredentialEntry": {
        "additionalProperties": false,
        "description": "One named connection: an endpoint plus its credential.",
        "properties": {
          "api_key": {
            "anyOf": [
              {
                "$ref": "#/definitions/ApiKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "The API key for the endpoint.\n\nOptional so a catalogue entry can name an endpoint whose secret is supplied only through the environment override; an absent or empty key is the fail-closed condition when the entry backs the active profile."
          },
          "base_url": {
            "description": "The endpoint base URL, stored verbatim and normalised at resolution.",
            "type": "string"
          },
          "provider_kind": {
            "allOf": [
              {
                "$ref": "#/definitions/ProviderKind"
              }
            ],
            "description": "The provider kind this connection serves."
          }
        },
        "required": [
          "base_url",
          "provider_kind"
        ],
        "type": "object"
      },
      "DatabaseConfig": {
        "additionalProperties": false,
        "description": "Configuration for the database connection pools.\n\nLoaded from the application YAML configuration file.  The `url` field is required; all other fields have sensible defaults for local development.\n\nTwo pools are created from this configuration: one for MCP read-path queries and one for worker write-path transactions.  Pool-specific settings (max connections, statement timeout) are selected by the startup sequence based on the pool name.",
        "properties": {
          "acquire_timeout_ms": {
            "description": "Milliseconds to wait when acquiring a connection before returning an error.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "max_connect_attempts": {
            "description": "Maximum connection attempts during startup (used by the startup sequence, not by this module directly).",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "pool_mcp_max_connections": {
            "description": "Maximum connections in the MCP (read-path) pool.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "pool_worker_max_connections": {
            "description": "Maximum connections in the worker (write-path) pool.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "statement_timeout_mcp_ms": {
            "description": "Statement timeout in milliseconds for MCP pool connections.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "statement_timeout_worker_ms": {
            "description": "Statement timeout in milliseconds for worker pool connections.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "url": {
            "description": "`PostgreSQL` connection URL (e.g. `postgres://user:pass@localhost:5432/tribal`).  Required; no default.",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "DiscoveryConfig": {
        "additionalProperties": false,
        "description": "Configuration for the discovery (semantic search) handler.\n\nControls result limits, overfetch behaviour, and similarity thresholds.",
        "properties": {
          "default_limit": {
            "description": "Default number of results when the caller does not specify a limit.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "max_limit": {
            "description": "Maximum number of results a caller may request.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "overfetch_multiplier": {
            "description": "Multiplier applied to the limit for the initial semantic search.\n\n`K = limit * overfetch_multiplier` rows are fetched, then filtered by similarity threshold.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "similarity_threshold": {
            "description": "Minimum cosine similarity to include a result.",
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "ExecutorChoice": {
        "description": "Which executor a stage's binding selects.",
        "oneOf": [
          {
            "description": "The single completion call, with no tools.",
            "enum": [
              "one_shot"
            ],
            "type": "string"
          },
          {
            "description": "The in-process turn loop with stage-scoped tools.",
            "enum": [
              "loop"
            ],
            "type": "string"
          }
        ]
      },
      "ExplorationConfig": {
        "additionalProperties": false,
        "description": "Configuration for the exploration (graph traversal) handler.\n\nControls depth and result limits.",
        "properties": {
          "default_depth": {
            "description": "Default traversal depth when not specified by the caller.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "default_limit": {
            "description": "Default number of results when the caller does not specify a limit.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "max_depth": {
            "description": "Maximum traversal depth (hard cap).",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "max_limit": {
            "description": "Maximum number of results a caller may request.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "FileRotation": {
        "description": "Trace file rotation policy.",
        "oneOf": [
          {
            "description": "Rotate daily (e.g. `traces-2026-03-13.jsonl`).",
            "enum": [
              "daily"
            ],
            "type": "string"
          },
          {
            "description": "Rotate hourly.",
            "enum": [
              "hourly"
            ],
            "type": "string"
          },
          {
            "description": "No rotation — single file.",
            "enum": [
              "never"
            ],
            "type": "string"
          }
        ]
      },
      "InferenceConfig": {
        "additionalProperties": false,
        "description": "Per-stage inference configuration.\n\nEach stage is independently configurable to allow cost/quality tuning — e.g. a capable model for extraction and a fast/cheap model for classification stages.",
        "properties": {
          "extraction": {
            "allOf": [
              {
                "$ref": "#/definitions/StageInferenceConfig"
              }
            ],
            "description": "Extraction stage configuration."
          },
          "relation": {
            "allOf": [
              {
                "$ref": "#/definitions/StageInferenceConfig"
              }
            ],
            "description": "Relation classification stage configuration."
          },
          "triage": {
            "allOf": [
              {
                "$ref": "#/definitions/StageInferenceConfig"
              }
            ],
            "description": "Triage stage configuration."
          }
        },
        "type": "object"
      },
      "InitConfig": {
        "additionalProperties": false,
        "description": "Fresh-system seed values, applied only when first creating a corpus.",
        "properties": {
          "embedding": {
            "allOf": [
              {
                "$ref": "#/definitions/InitEmbeddingConfig"
              }
            ],
            "description": "Genesis embedding identity."
          }
        },
        "type": "object"
      },
      "InitEmbeddingConfig": {
        "additionalProperties": false,
        "description": "The genesis embedding identity used to seed the first profile.\n\nCarries no credential: the runtime resolves the active provider's credential through the credential catalogue, keyed by `(provider_kind, normalised_base_url)`, because after a migration the active provider can differ from this genesis provider and the runtime must follow the active one. `dimensions` is optional: `None` resolves through the embedding service's native-dimension chain at provisioning.",
        "properties": {
          "base_url": {
            "description": "Base URL for the provider API.\n\nWhen `None`, the provider supplies its own default.",
            "type": [
              "string",
              "null"
            ]
          },
          "dimensions": {
            "description": "Target output dimensionality. `None` resolves through the embedding service's native-dimension chain when the genesis profile is created.",
            "format": "uint32",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          },
          "model": {
            "description": "Genesis embedding model name.",
            "type": "string"
          },
          "provider": {
            "allOf": [
              {
                "$ref": "#/definitions/ProviderKind"
              }
            ],
            "description": "Genesis embedding provider."
          }
        },
        "type": "object"
      },
      "LimitsConfig": {
        "additionalProperties": false,
        "description": "Per-provider concurrency limits.\n\nBounds in-flight requests to any single external service, preventing worker tasks from starving MCP read-path queries that share the same provider.",
        "properties": {
          "providers": {
            "additionalProperties": {
              "$ref": "#/definitions/ProviderLimitsConfig"
            },
            "description": "Per-provider limits, keyed by provider kind.\n\nPre-populated with a default for every provider kind.  Typed keys mean a YAML typo fails at parse time rather than silently creating an unreferenced entry.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "LogFormat": {
        "description": "Output format for log lines.",
        "oneOf": [
          {
            "description": "Structured JSON output, one object per line (JSONL).\n\nIncludes level, target, span context, timestamp, and message. Suitable for log aggregation and machine parsing.",
            "enum": [
              "json"
            ],
            "type": "string"
          },
          {
            "description": "Human-readable coloured output for terminal use.\n\nUses `tracing-subscriber`'s pretty formatter with ANSI colours when writing to a TTY.",
            "enum": [
              "pretty"
            ],
            "type": "string"
          }
        ]
      },
      "LogOutput": {
        "description": "Output destination for log lines.",
        "oneOf": [
          {
            "description": "Write log output to standard error.",
            "enum": [
              "stderr"
            ],
            "type": "string"
          },
          {
            "description": "Write log output to a rolling file in [`LoggingConfig::file_directory`].",
            "enum": [
              "file"
            ],
            "type": "string"
          }
        ]
      },
      "LoggingConfig": {
        "additionalProperties": false,
        "description": "Configuration for the tracing subscriber.\n\nLoaded from the application configuration file.  All fields have sensible defaults for local development (info level, JSON format, stderr output).",
        "properties": {
          "file_directory": {
            "description": "Directory for log file output when [`output`](LoggingConfig::output) is [`LogOutput::File`].\n\nResolved at startup via platform-aware defaults: `dirs::state_dir` → `dirs::data_local_dir` → `std::env::temp_dir`, each joined with `tribal/logs`.",
            "type": "string"
          },
          "file_rotation": {
            "allOf": [
              {
                "$ref": "#/definitions/FileRotation"
              }
            ],
            "description": "Log file rotation policy.\n\nDefaults to [`FileRotation::Daily`]."
          },
          "format": {
            "allOf": [
              {
                "$ref": "#/definitions/LogFormat"
              }
            ],
            "description": "Output format for log lines.\n\nDefaults to [`LogFormat::Json`] for structured output suitable for log aggregation."
          },
          "include_llm_content": {
            "description": "Whether to include raw LLM request/response content in log output.\n\nDefaults to `false`.  When `true`, inference-related spans and events may include prompt text and model responses, which can be large and contain sensitive information.",
            "type": "boolean"
          },
          "level": {
            "description": "Tracing filter directive string.\n\nSupports per-module granularity, e.g. `\"info,tribal_db=debug\"`. Defaults to `\"info\"`.  The `TRIBAL_LOG` environment variable, mapped by the configuration loader, takes precedence over a YAML-supplied value for this field.",
            "type": "string"
          },
          "output": {
            "allOf": [
              {
                "$ref": "#/definitions/LogOutput"
              }
            ],
            "description": "Output destination for log lines.\n\nDefaults to [`LogOutput::Stderr`]."
          }
        },
        "type": "object"
      },
      "OAuthConfig": {
        "additionalProperties": false,
        "description": "OAuth 2.1 authorisation-server configuration.\n\n`issuer_url` is the canonical authorisation-server identifier; `resource_url` is the canonical resource identifier the AS issues audience-bound tokens for. When either is `None`, the consumer derives it from the server bind address at startup.",
        "properties": {
          "access_token_ttl_hours": {
            "description": "OAuth-issued access-token TTL in hours.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "authorization_code_ttl_seconds": {
            "description": "Authorisation-code TTL in seconds.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "dcr_enabled": {
            "description": "Whether the DCR `/register` endpoint is enabled.",
            "type": "boolean"
          },
          "issuer_url": {
            "description": "Canonical authorisation-server issuer URL. Derived from the server bind address when omitted.",
            "type": [
              "string",
              "null"
            ]
          },
          "resource_url": {
            "description": "Canonical protected-resource URL. Derived from the server bind address plus `/mcp` when omitted.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "PromptSource": {
        "description": "Where the active prompts are loaded from.\n\n`Embedded` reads the six prompts compiled into the binary via `include_str!`. `Disk` reads them from `directory`, writing the embedded defaults on first run if files are missing; setting `hot_reload: true` spawns a watcher that reloads on file change.\n\nThe shape makes invalid states unrepresentable — `hot_reload` is only reachable when an on-disk source actually exists.",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "Prompts compiled into the binary.\n\nEmpty struct variant rather than a unit variant: serde's `deny_unknown_fields` is only honoured for struct-variant arms of internally-tagged enums, so the empty braces are what make `{kind: embedded, hot_reload: true}` fail to deserialise.",
            "properties": {
              "kind": {
                "enum": [
                  "embedded"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Prompts read from a directory on disk.",
            "properties": {
              "directory": {
                "description": "Directory containing prompt template files. Supports tilde (`~`).",
                "type": "string"
              },
              "hot_reload": {
                "description": "Whether to watch for file changes and reload automatically.",
                "type": "boolean"
              },
              "kind": {
                "enum": [
                  "disk"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "PromptsConfig": {
        "additionalProperties": false,
        "description": "Wrapper around [`PromptSource`].\n\nA struct rather than an inline enum so future prompt-wide knobs (e.g. global cache settings) can land without breaking the YAML schema.",
        "properties": {
          "source": {
            "allOf": [
              {
                "$ref": "#/definitions/PromptSource"
              }
            ],
            "description": "Where the active prompts are loaded from."
          }
        },
        "type": "object"
      },
      "ProviderKind": {
        "description": "LLM provider.\n\nUsed as the type for embedding and per-stage inference configuration, as the key type for per-provider limits, and as the capability-resolution key (with the model string) for request-field admissibility.",
        "oneOf": [
          {
            "description": "Local `Ollama` instance.",
            "enum": [
              "ollama"
            ],
            "type": "string"
          },
          {
            "description": "`Anthropic` cloud API.",
            "enum": [
              "anthropic"
            ],
            "type": "string"
          },
          {
            "description": "`OpenAI` cloud API.",
            "enum": [
              "openai"
            ],
            "type": "string"
          },
          {
            "description": "Tribal's managed platform. A metered provider whose transport is the control-plane gateway, not a raw HTTP endpoint — so it authenticates with the platform credential and has no built-in base URL or request path of its own.",
            "enum": [
              "platform"
            ],
            "type": "string"
          }
        ]
      },
      "ProviderLimitsConfig": {
        "additionalProperties": false,
        "description": "Concurrency and timeout limits for a single provider.",
        "properties": {
          "max_in_flight": {
            "description": "Maximum concurrent in-flight requests.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "request_timeout_ms": {
            "description": "Per-request timeout in milliseconds.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "max_in_flight",
          "request_timeout_ms"
        ],
        "type": "object"
      },
      "ServerConfig": {
        "additionalProperties": false,
        "description": "Top-level server configuration.\n\nControls the transport protocol, bind address, shutdown behaviour, and SSE-specific tuning.",
        "properties": {
          "bind_address": {
            "description": "Socket address to bind the HTTP/SSE listener to.\n\n`None` when using stdio transport.  When transport is HTTP or SSE and this is `None`, the startup sequence supplies [`DEFAULT_BIND_ADDRESS`] (`127.0.0.1:8725`) as a fallback.",
            "type": [
              "string",
              "null"
            ]
          },
          "job_state_hard_ttl_seconds": {
            "description": "Hard upper bound on watch-channel entry lifetime regardless of terminal state, in seconds.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "job_state_ttl_seconds": {
            "description": "How long to retain a watch-channel entry after the job reaches a terminal state, in seconds.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "shutdown_deadline_ms": {
            "description": "Graceful shutdown deadline in milliseconds.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "sse": {
            "allOf": [
              {
                "$ref": "#/definitions/SseConfig"
              }
            ],
            "description": "SSE-specific connection settings."
          },
          "transport": {
            "allOf": [
              {
                "$ref": "#/definitions/TransportKind"
              }
            ],
            "description": "Transport protocol for the MCP server."
          }
        },
        "type": "object"
      },
      "SseConfig": {
        "additionalProperties": false,
        "description": "SSE-specific connection settings.\n\nNested under `server.sse` in the configuration file.",
        "properties": {
          "idle_timeout_ms": {
            "description": "Close SSE connection if no real events for this many milliseconds.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "keepalive_interval_ms": {
            "description": "SSE comment keepalive interval in milliseconds.\n\nPrevents proxy timeouts on idle connections.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "max_connection_age_ms": {
            "description": "Maximum SSE connection lifetime in milliseconds.\n\nForces re-authentication after this period.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "StageAgentConfig": {
        "additionalProperties": false,
        "description": "One stage's agentic configuration.",
        "properties": {
          "execution_deadline_seconds": {
            "description": "Override for the execution deadline, in seconds; the named default applies when absent.",
            "format": "uint32",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          },
          "executor": {
            "allOf": [
              {
                "$ref": "#/definitions/ExecutorChoice"
              }
            ],
            "description": "The executor the stage runs under."
          },
          "max_total_tokens": {
            "description": "Override for the token cap; the named default applies when absent.",
            "format": "uint64",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_turns": {
            "description": "Override for the turn cap; the named default applies when absent.",
            "format": "uint32",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          },
          "verifier": {
            "description": "Whether an accepted submission is verified by a child execution. Absent leaves the stage's loop default in force: triage and relation verify by default, extraction has no verifier. It is honoured only under the loop executor; setting it under one-shot, where there is no submission loop to verify, is inert and surfaced as a startup advisory.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "StageInferenceConfig": {
        "additionalProperties": false,
        "description": "Configuration for a single inference stage.\n\nWhen `base_url` is `None`, the provider implementation supplies its own default URL.",
        "properties": {
          "api_key": {
            "anyOf": [
              {
                "$ref": "#/definitions/ApiKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "API key for cloud providers."
          },
          "base_url": {
            "description": "Base URL for the provider API.",
            "type": [
              "string",
              "null"
            ]
          },
          "max_tokens": {
            "description": "Maximum output tokens. `None` uses the provider default.",
            "format": "uint32",
            "minimum": 0.0,
            "type": [
              "integer",
              "null"
            ]
          },
          "model": {
            "description": "Model name.",
            "type": "string"
          },
          "provider": {
            "allOf": [
              {
                "$ref": "#/definitions/ProviderKind"
              }
            ],
            "description": "LLM provider."
          },
          "temperature": {
            "description": "Sampling temperature. `None` uses the provider default.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "model"
        ],
        "type": "object"
      },
      "TelemetryConfig": {
        "additionalProperties": false,
        "description": "OpenTelemetry and trace export configuration.",
        "properties": {
          "console_export": {
            "description": "Print spans to stderr (development).",
            "type": "boolean"
          },
          "enabled": {
            "description": "Master switch for telemetry.",
            "type": "boolean"
          },
          "file_directory": {
            "description": "Directory for trace file output.\n\nResolved at startup via platform-aware defaults: `dirs::data_local_dir` → `std::env::temp_dir`, each joined with `tribal/traces`.",
            "type": "string"
          },
          "file_export": {
            "description": "Write spans to file.",
            "type": "boolean"
          },
          "file_rotation": {
            "allOf": [
              {
                "$ref": "#/definitions/FileRotation"
              }
            ],
            "description": "Trace file rotation policy."
          },
          "otlp_endpoint": {
            "description": "OTLP exporter endpoint (e.g. `http://localhost:4317`).",
            "type": [
              "string",
              "null"
            ]
          },
          "otlp_protocol": {
            "description": "OTLP protocol (`grpc` or `http`).",
            "type": "string"
          },
          "service_name": {
            "description": "Service name reported in spans.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TransportKind": {
        "description": "Transport protocol for the MCP server.\n\nDetermines how the server communicates with clients.  The HTTP/SSE startup path supplies `127.0.0.1:8725` as a fallback when `bind_address` is `None` and transport is not `Stdio`.\n\nImplements [`FromStr`] so that clap can parse the type natively without a mirror enum.",
        "oneOf": [
          {
            "description": "Communicate over stdin/stdout.",
            "enum": [
              "stdio"
