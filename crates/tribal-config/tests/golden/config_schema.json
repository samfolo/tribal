      "WorkerConfig": {
        "additionalProperties": false,
        "description": "Configuration for the worker loop.\n\nAll duration fields are expressed as integer milliseconds and converted to [`Duration`] via convenience methods.  Defaults are applied via `serde(default)` so that an empty YAML object deserialises to a valid configuration.",
        "properties": {
          "heartbeat_interval_ms": {
            "description": "Milliseconds between heartbeat updates for claimed tasks.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "max_candidates_per_job": {
            "description": "Maximum candidate count per job (cap applied during extraction).",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "max_concurrent_tasks": {
            "description": "Maximum number of concurrently executing tasks.",
            "format": "uint",
            "minimum": 0.0,
            "type": "integer"
          },
          "poll_interval_ms": {
            "description": "Milliseconds between poll cycles.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "reclaim_interval_ms": {
            "description": "Milliseconds between stale-task reclaim sweeps.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "tag_similarity_threshold": {
            "description": "Minimum cosine similarity for semantic tag matching (0.0, 1.0].",
            "format": "double",
            "type": "number"
          },
          "task_max_retries": {
            "description": "Maximum retries before a task is dead-lettered.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          },
          "task_timeout_ms": {
            "description": "Per-task timeout in milliseconds.",
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "triage_search_limit": {
            "description": "Number of similar items returned during triage search.",
            "format": "uint32",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
