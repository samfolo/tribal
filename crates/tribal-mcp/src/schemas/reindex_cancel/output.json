{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpReindexCancelResponse",
  "description": "The MCP response for `tribal_reindex_cancel`.",
  "type": "object",
  "required": [
    "cancelled"
  ],
  "properties": {
    "cancelled": {
      "description": "Whether a live run was transitioned to aborted.",
      "type": "boolean"
    },
    "run_id": {
      "description": "The aborted run's id, present only when a run was cancelled.",
      "type": [
        "string",
        "null"
      ]
    }
  }
}
