{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpIngestRequest",
  "description": "Deserialisation target for `tribal_ingest` input.",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "string"
    },
    "idempotency_key": {
      "description": "Producer-generated key reused only for retries of one logical ingest operation; absent for ordinary create-on-every-call use.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
