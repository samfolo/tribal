{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpIngestRequest",
  "description": "Deserialisation target for `tribal_ingest` input.",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "description": "Raw text submitted for extraction.",
      "type": "string"
    },
    "idempotency_key": {
      "description": "Producer-generated key reused only for retries of one logical ingest operation; absent for ordinary create-on-every-call use.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "project": {
      "description": "Requested target; absence applies connection, process, then System defaults.",
      "anyOf": [
        {
          "$ref": "#/definitions/RequestedProject"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ProjectId": {
      "type": "string",
      "pattern": "^proj_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "x-tribal-swift-type": "validated-string"
    },
    "RequestedProject": {
      "description": "Project target named by an ingest request.",
      "oneOf": [
        {
          "description": "A specific project named by identifier.",
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/ProjectId"
            },
            "kind": {
              "type": "string",
              "enum": [
                "explicit"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "The graph-owned System project.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "system"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
