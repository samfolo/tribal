{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpReindexResponse",
  "description": "The MCP response for `tribal_reindex`.",
  "type": "object",
  "required": [
    "base_url",
    "dimensions",
    "estimated_items",
    "estimated_tags",
    "model",
    "outcome",
    "provider"
  ],
  "properties": {
    "base_url": {
      "description": "The resolved, normalised target endpoint.",
      "type": "string"
    },
    "dimensions": {
      "description": "The resolved target dimension.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "estimated_items": {
      "description": "The number of items the new geometry must embed.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "estimated_tags": {
      "description": "The number of tags the new geometry must embed.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "model": {
      "description": "The resolved target model.",
      "type": "string"
    },
    "outcome": {
      "description": "The outcome: `plan` for a dry run, otherwise `created`, `unchanged`, `already_live`, or `lock_contended`.",
      "type": "string"
    },
    "provider": {
      "description": "The resolved target provider.",
      "type": "string"
    },
    "run_id": {
      "description": "The run id, present for `created` and `already_live`.",
      "type": [
        "string",
        "null"
      ]
    }
  }
}
