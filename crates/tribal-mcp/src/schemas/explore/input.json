{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpExploreRequest",
  "description": "Deserialisation target for `tribal_explore` input.",
  "type": "object",
  "required": [
    "item_id"
  ],
  "properties": {
    "depth": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "direction": {
      "type": [
        "string",
        "null"
      ]
    },
    "include_references": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "include_standing": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "item_id": {
      "type": "string"
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "relation_types": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "session_trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
