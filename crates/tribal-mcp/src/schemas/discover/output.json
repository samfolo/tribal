{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpDiscoverResponse",
  "description": "Response for `tribal_discover`.",
  "type": "object",
  "required": [
    "embedding_model",
    "embedding_profile_id",
    "exact",
    "items",
    "trace_id"
  ],
  "properties": {
    "applied_project_id": {
      "description": "Required + nullable — always present in serialised JSON.",
      "type": [
        "string",
        "null"
      ]
    },
    "embedding_model": {
      "type": "string"
    },
    "embedding_profile_id": {
      "description": "The active embedding profile that produced these results. Cursors and feedback are bound to it; a reindex changes it.",
      "type": "string"
    },
    "exact": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/McpDiscoveryResult"
      }
    },
    "next_cursor": {
      "description": "Required + nullable — always present (null when no more results).",
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": "string"
    }
  },
  "definitions": {
    "Confidence": {
      "description": "The confidence level of a knowledge item.",
      "oneOf": [
        {
          "description": "Manually confirmed or from an authoritative source.",
          "type": "string",
          "enum": [
            "verified"
          ]
        },
        {
          "description": "Extracted by a model from a conversation or document.",
          "type": "string",
          "enum": [
            "inferred"
          ]
        },
        {
          "description": "Flagged as potentially inaccurate or context-dependent.",
          "type": "string",
          "enum": [
            "uncertain"
          ]
        }
      ]
    },
    "KnowledgeKind": {
      "description": "The kind of knowledge captured.",
      "oneOf": [
        {
          "description": "A discrete, verifiable piece of information.",
          "type": "string",
          "enum": [
            "fact"
          ]
        },
        {
          "description": "A rule of thumb or pattern derived from experience.",
          "type": "string",
          "enum": [
            "heuristic"
          ]
        },
        {
          "description": "A sequence of steps to accomplish something.",
          "type": "string",
          "enum": [
            "procedure"
          ]
        },
        {
          "description": "A record of a choice made and its rationale.",
          "type": "string",
          "enum": [
            "decision_record"
          ]
        }
      ]
    },
    "McpDiscoveryResult": {
      "description": "A single discovery result with its similarity score.",
      "type": "object",
      "required": [
        "item",
        "similarity"
      ],
      "properties": {
        "item": {
          "$ref": "#/definitions/McpKnowledgeItem"
        },
        "references": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/McpReference"
          }
        },
        "similarity": {
          "type": "number",
          "format": "double"
        },
        "standing": {
          "anyOf": [
            {
              "$ref": "#/definitions/McpStanding"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "McpKnowledgeItem": {
      "description": "MCP-surface representation of a knowledge item.\n\nAll ID fields carry their type prefix (e.g. `ki_`, `proj_`, `ep_`). The `principal_key` field is the human-readable string, not the UUID.",
      "type": "object",
      "required": [
        "confidence",
        "content",
        "created_at",
        "id",
        "kind",
        "principal_key",
        "project_id",
        "source_context",
        "tags"
      ],
      "properties": {
        "capture_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "capture_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/definitions/Confidence"
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "episode_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/KnowledgeKind"
        },
        "principal_key": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "source_context": {
          "$ref": "#/definitions/McpSourceContext"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "McpReference": {
      "description": "MCP-surface representation of a reference.\n\nProjects a subset of the domain `Reference` fields — excludes `knowledge_item_id`, `project_id`, and `branch`.",
      "type": "object",
      "required": [
        "id",
        "kind",
        "value"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ReferenceKind"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "McpSourceContext": {
      "description": "Flattened provenance summary extracted from the opaque JSONB `source_context` column.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "model": {
          "description": "Model identifier (e.g. `\"claude-opus-4-6\"`).",
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "description": "Inference provider name (e.g. `\"anthropic\"`).",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "Discriminator — always present.",
          "allOf": [
            {
              "$ref": "#/definitions/McpSourceType"
            }
          ]
        }
      }
    },
    "McpSourceType": {
      "description": "Source type on the MCP surface.\n\nMaps from the internal `source_context` JSONB discriminator to the three values exposed to clients.",
      "oneOf": [
        {
          "description": "Captured via a model-mediated pipeline (e.g. agent ingesting via MCP).",
          "type": "string",
          "enum": [
            "agent_mediated"
          ]
        },
        {
          "description": "Human-initiated capture without model mediation.",
          "type": "string",
          "enum": [
            "manual"
          ]
        },
        {
          "description": "Produced by synthesis or compaction from existing items.",
          "type": "string",
          "enum": [
            "derived"
          ]
        }
      ]
    },
    "McpStanding": {
      "description": "Computed evidential profile on the MCP surface.\n\nID fields are rendered as prefixed strings. Optional IDs are omitted from serialised JSON when absent.",
      "type": "object",
      "required": [
        "contradicting_count",
        "observation_count",
        "supporting_count",
        "supporting_episode_count",
        "supporting_project_count"
      ],
      "properties": {
        "contradicting_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "newest_contradicting_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "newest_supporting_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "supporting_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "supporting_episode_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "supporting_project_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ReferenceKind": {
      "description": "The classification of a reference attached to a knowledge item.",
      "oneOf": [
        {
          "description": "Project-relative file path (sigil `//`).",
          "type": "string",
          "enum": [
            "file_path"
          ]
        },
        {
          "description": "External URL.",
          "type": "string",
          "enum": [
            "url"
          ]
        },
        {
          "description": "Abstract reference too general for a path or URL.",
          "type": "string",
          "enum": [
            "concept"
          ]
        },
        {
          "description": "Code symbol (function, type, module).",
          "type": "string",
          "enum": [
            "symbol"
          ]
        }
      ]
    }
  }
}
