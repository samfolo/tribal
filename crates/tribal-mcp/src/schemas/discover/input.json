{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpDiscoverRequest",
  "description": "Deserialisation target for `tribal_discover` input.",
  "type": "object",
  "required": [
    "query"
  ],
  "properties": {
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "include_references": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "include_standing": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "include_superseded": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "kinds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/KnowledgeKind"
      }
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "project_id": {
      "description": "Three-way semantics: absent → use session project; explicit null → search globally; present → filter to this project. `skip_serializing_if` keeps an absent value absent (not `null`) on the way out, so a client sending only a query stays session-scoped rather than going global.",
      "type": [
        "string",
        "null"
      ]
    },
    "query": {
      "type": "string"
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "time_range": {
      "anyOf": [
        {
          "$ref": "#/definitions/McpTimeRange"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "KnowledgeKind": {
      "description": "The kind of knowledge captured.",
      "oneOf": [
        {
          "description": "A discrete, verifiable piece of information.",
          "type": "string",
          "enum": [
            "fact"
          ]
        },
        {
          "description": "A rule of thumb or pattern derived from experience.",
          "type": "string",
          "enum": [
            "heuristic"
          ]
        },
        {
          "description": "A sequence of steps to accomplish something.",
          "type": "string",
          "enum": [
            "procedure"
          ]
        },
        {
          "description": "A record of a choice made and its rationale.",
          "type": "string",
          "enum": [
            "decision_record"
          ]
        }
      ]
    },
    "McpTimeRange": {
      "description": "Time range filter for discovery queries.",
      "type": "object",
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
