{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpSetContextResponse",
  "description": "Typed response for `tribal_set_context`.\n\nThe `project` field is non-required in the output schema but always included (null when absent) for consistency with the session resource representation.",
  "type": "object",
  "required": [
    "actor",
    "principal_key"
  ],
  "properties": {
    "actor": {
      "$ref": "#/definitions/McpSessionActor"
    },
    "principal_key": {
      "type": "string"
    },
    "project": {
      "anyOf": [
        {
          "$ref": "#/definitions/McpSessionProject"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "GitRemote": {
      "type": "string",
      "pattern": "^[^\\s/]+/\\S*$",
      "x-tribal-swift-type": "validated-string"
    },
    "McpSessionActor": {
      "description": "Actor metadata on the MCP `set_context` response surface.\n\nAll fields are always present in serialised JSON (null when absent), matching the existing session resource representation.",
      "type": "object",
      "properties": {
        "client_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "McpSessionProject": {
      "description": "Project on the MCP `set_context` response surface.",
      "type": "object",
      "required": [
        "id",
        "name",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/definitions/ProjectOrigin"
        }
      }
    },
    "ProjectOrigin": {
      "description": "The source of a project's stable identity.",
      "oneOf": [
        {
          "description": "The graph-wide project maintained by Tribal.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "system"
              ]
            }
          }
        },
        {
          "description": "A project established from a Git remote.",
          "type": "object",
          "required": [
            "default_branch",
            "kind",
            "remote"
          ],
          "properties": {
            "default_branch": {
              "description": "Branch used when a caller supplies no branch.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "git"
              ]
            },
            "remote": {
              "description": "Canonical remote identity.",
              "allOf": [
                {
                  "$ref": "#/definitions/GitRemote"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
