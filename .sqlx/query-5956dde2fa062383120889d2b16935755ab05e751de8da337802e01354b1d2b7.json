  "query": "\n            INSERT INTO projects (origin, name, project_type, schema_version, settings)\n            VALUES (\n                jsonb_build_object(\n                    'kind', 'git',\n                    'remote', $1::text,\n                    'default_branch', $2::text\n                ),\n                $3, $4, $5, $6\n            )\n            RETURNING *\n            ",
