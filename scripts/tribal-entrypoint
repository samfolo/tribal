#!/usr/bin/env bash
# Tribal container lifecycle. The manager owns configuration and the managed
# network runtime; this shell only projects bootstrap and signal shutdown.

set -euo pipefail

if [[ $# -gt 0 ]]; then
  exec "$@"
fi

shutdown_manager() {
  tribal manager shutdown >/dev/null 2>&1 || true
  rm -f "${manager_record:-}"
}

trap shutdown_manager EXIT INT TERM

manager_record="$(mktemp)"
tribal manager run --announce-json >"$manager_record" &
manager_pid="$!"
for _ in $(seq 1 600); do
  [[ -s "$manager_record" ]] && break
  if ! kill -0 "$manager_pid" 2>/dev/null; then
    break
  fi
  sleep 0.05
done
if ! IFS= read -r announcement <"$manager_record"; then
  echo "tribal manager exited before announcing readiness" >&2
  wait "$manager_pid"
  exit 1
fi
if ! jq -e '.status == "ready" and .data.announcement.socket_path and .data.announcement.config_path' <<<"$announcement" >/dev/null; then
  echo "tribal manager returned an invalid launch receipt" >&2
  exit 1
fi

bootstrap_receipt="$(tribal bootstrap --auth persisted-bearer --json)"
if ! jq -e '.config_revision and .value.database and .value.handoff' <<<"$bootstrap_receipt" >/dev/null; then
  echo "tribal bootstrap returned an invalid receipt" >&2
  exit 1
fi

integration_receipt="$(tribal integration mcp-config --auth persisted-bearer --json)"
if ! jq -e '.config_revision and .value.data.document' <<<"$integration_receipt" >/dev/null; then
  echo "tribal integration mcp-config returned an invalid receipt" >&2
  exit 1
fi

tribal runtime start --json >/dev/null

cat >&2 <<'EOF'
================================================================
Tribal is running on http://localhost:8725/mcp.

To wire Tribal into Claude Code, run this from your host shell:
  claude mcp add-json tribal "$(docker compose exec tribal tribal integration mcp-config --auth persisted-bearer --json | jq -c '.value.data.document')"

To verify readiness:
  docker compose exec tribal tribal check
================================================================
EOF

wait "$manager_pid"
trap - EXIT INT TERM
